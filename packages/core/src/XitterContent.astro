---
import type { Xitter } from './types';

import Link from './Link.astro';

interface Props {
  tweet: Xitter;
}

const { tweet } = Astro.props;

const isTruncated = !!tweet.note_tweet;

let content = tweet.text;
if (tweet.entities.urls) {
  for (const url of tweet.entities.urls) {
    content = `${content.slice(0, url.indices[0])}<a href="${url.expanded_url}" rel="noreferrer noopener" class="astro-xitter-content-link astro-xitter-link">${url.display_url}</a> ${content.slice(url.indices[0] + url.indices[1])}`;
  }
}

if (tweet.entities.user_mentions) {
  for (const url of tweet.entities.user_mentions) {
    content = `${content.slice(0, url.indices[0])}<a href="https://x.com/${url.screen_name}" target="_blank" rel="noreferrer noopener" class="astro-xitter-content-link astro-xitter-link">@${url.screen_name}</a> ${content.slice(url.indices[0] + url.indices[1])}`;
  }
}

if (tweet.entities.hashtags) {
  for (const url of tweet.entities.hashtags) {
    content = `${content.slice(0, url.indices[0])}<a href="https://x.com/hashtag/${url.text}" target="_blank" rel="noreferrer noopener" class="astro-xitter-content-link astro-xitter-link">#${url.text}</a> ${content.slice(url.indices[0] + url.indices[1])}`;
  }
}
---

<div class="astro-xitter-content">
  <Fragment set:html={content} />
  {
    isTruncated && (
      <>
        {'... '}
        <Link
          class="astro-xitter-content-truncated-notice astro-xitter-link"
          href={`https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}`}
        >
          Show More
        </Link>
      </>
    )
  }
</div>

<style>
  .astro-xitter-content {
    white-space: pre-wrap;
    color: var(--astro-xitter-content);
    margin-top: calc(3 * var(--astro-xitter-spacing));

    font-size: var(--astro-xitter-text-lg);
    line-height: 1.3;
  }

  .astro-xitter-content-truncated-notice {
    color: var(--astro-xitter-blue-link);

    font-size: var(--astro-xitter-text-lg);
    line-height: 1.3;

    &:hover,
    &:focus-visible {
      text-decoration-color: var(--astro-xitter-blue-link);
    }
  }

  :global(.astro-xitter-content-link) {
    color: var(--astro-xitter-blue-link);

    &:hover,
    &:focus-visible {
      text-decoration-color: var(--astro-xitter-blue-link);
    }
  }
</style>
