---
import type { Xitter, XitterHost } from './types';

import { processContent } from './content';
import { resolveTweetLink } from './link';
import Link from './Link.astro';

interface Props {
  tweet: Xitter;

  host: XitterHost;
}

const { tweet, host } = Astro.props;
const { content, isTruncated } = processContent(tweet, { interactive: true, host: host });
---

<div class="astro-xitter-content" lang={tweet.lang} dir="auto">
  <Fragment set:html={content} />
  {
    isTruncated && (
      <>
        {'... '}
        <Link class="astro-xitter-content-truncated-notice astro-xitter-link" href={resolveTweetLink(tweet, host)}>
          Show More
        </Link>
      </>
    )
  }
</div>

<style>
  .astro-xitter-content {
    white-space: pre-wrap;
    color: var(--astro-xitter-content);
    margin-top: calc(3 * var(--astro-xitter-spacing));

    font-size: var(--astro-xitter-text-lg);
    line-height: calc(5 * var(--astro-xitter-spacing) / var(--astro-xitter-text-md));
  }

  .astro-xitter-content-truncated-notice {
    color: var(--astro-xitter-link);

    font-size: var(--astro-xitter-text-lg);
    line-height: 1.3;

    &:hover,
    &:focus-visible {
      text-decoration-color: var(--astro-xitter-link);
    }
  }

  :global(.astro-xitter-content-link) {
    color: var(--astro-xitter-link);

    &:hover,
    &:focus-visible {
      text-decoration-color: var(--astro-xitter-link);
    }
  }
</style>
