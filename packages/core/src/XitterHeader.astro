---
import type { Xitter } from './types';

import { XitterUserVerifiedType } from './const';
import Verified from './icons/Verified.astro';
import Link from './Link.astro';

interface Props {
  tweet: Xitter;
}

const { tweet } = Astro.props;
const user = tweet.user;

const isVerified =
  tweet.user.is_blue_verified ||
  tweet.user.verified ||
  ['Business', 'Government'].includes(tweet.user.verified_type ?? '');
---

<div class="astro-xitter-header-container">
  <Link title="View Profile on X" href={`https://x.com/${user.screen_name}`} class="astro-xitter-profile-picture">
    <img
      src={user.profile_image_url_https}
      class:list={[
        'astro-xitter-profile-avatar',
        {
          'astro-xitter-profile-avatar-square': user.profile_image_shape === 'Square',
        },
      ]}
    />
  </Link>

  <div class="astro-xitter-profile">
    <Link
      title="View Profile on X"
      class="astro-xitter-profile-name astro-xitter-link"
      href={`https://x.com/${user.screen_name}`}
    >
      {user.name}

      {
        isVerified && (
          <Verified
            type={user.verified_type}
            class:list={[
              'astro-xitter-profile-verified-badge',
              {
                'astro-xitter-profile-verified-government': user.verified_type === XitterUserVerifiedType.Government,
                'astro-xitter-profile-verified-personal':
                  user.verified_type !== XitterUserVerifiedType.Business &&
                  user.verified_type !== XitterUserVerifiedType.Government,
              },
            ]}
          />
        )
      }

      {
        user.highlighted_label?.badge?.url && (
          <img src={user.highlighted_label.badge.url} class="astro-xitter-profile-highlighted-label" />
        )
      }
    </Link>

    <div class="astro-xitter-profile-screen">
      <Link
        title="View Profile on X"
        href={`https://x.com/${user.screen_name}`}
        class="astro-xitter-profile-screen-name astro-xitter-link"
      >
        @{user.screen_name}
      </Link>

      <span class="astro-xitter-profile-separator">&middot;</span>

      <Link
        class="astro-xitter-profile-screen-follow astro-xitter-link"
        title="View Profile on X"
        href={`https://x.com/intent/follow?screen_name=${user.screen_name}`}
      >
        Follow
      </Link>
    </div>
  </div>
</div>

<style>
  .astro-xitter-header-container {
    display: flex;
    align-items: center;
    gap: calc(2 * var(--astro-xitter-spacing));

    margin: 0;
  }

  .astro-xitter-profile-picture {
    flex-shrink: 0;
  }

  .astro-xitter-profile-avatar {
    filter: brightness(1);
    transition: filter var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);
    border-radius: 9999px;

    &:hover,
    &:focus {
      filter: brightness(0.9);
    }

    &.astro-xitter-profile-avatar-square {
      border-radius: var(--astro-xitter-spacing);
    }
  }

  .astro-xitter-profile {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--astro-xitter-spacing);
  }

  .astro-xitter-profile-name {
    font-weight: 600;
    color: var(--astro-xitter-header);
    display: inline-flex;
    align-items: center;
    gap: var(--astro-xitter-spacing);

    line-height: 1.25;

    width: fit-content;

    &:hover,
    &:focus-visible {
      text-decoration-color: var(--astro-xitter-header);
    }
  }

  .astro-xitter-profile-verified-badge {
    flex-shrink: 0;
    width: calc(4.5 * var(--astro-xitter-spacing));
    height: auto;

    &.astro-xitter-profile-verified-government {
      color: var(--astro-xitter-gray);
    }

    &.astro-xitter-profile-verified-personal {
      color: var(--astro-xitter-blue);
    }
  }

  .astro-xitter-profile-screen {
    display: flex;
    align-items: center;
    line-height: 1;
    gap: var(--astro-xitter-spacing);
    color: var(--astro-xitter-subheader);
  }

  .astro-xitter-profile-screen-name {
    color: var(--astro-xitter-subheader);
  }

  .astro-xitter-profile-screen-follow {
    font-weight: 600;
    color: var(--astro-xitter-link);

    &:hover,
    &:focus-visible {
      text-decoration-color: var(--astro-xitter-link);
    }
  }

  .astro-xitter-profile-highlighted-label {
    box-sizing: border-box;

    width: calc(4 * var(--astro-xitter-spacing));
    height: calc(4 * var(--astro-xitter-spacing));

    border: 1px solid var(--astro-xitter-separator);

    margin: 0;
  }

  :global([data-theme='light']) .astro-xitter-profile-verified-badge {
    &.astro-xitter-profile-verified-personal {
      color: var(--astro-xitter-blue);
    }
  }

  :global([data-theme='dark']) .astro-xitter-profile-verified-badge {
    &.astro-xitter-profile-verified-personal {
      color: var(--astro-xitter-header);
    }
  }
</style>
