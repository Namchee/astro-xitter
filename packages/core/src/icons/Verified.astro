---
import type { HTMLAttributes } from 'astro/types';

import type { TweetUser } from '../types';

import VerifiedBusiness from './VerifiedBusiness.astro';
import VerifiedGovernment from './VerifiedGovernment.astro';
import VerifiedPersonal from './VerifiedPersonal.astro';

interface Props extends HTMLAttributes<'svg'> {
  type: TweetUser['verified_type'];
}

const { type, ...props } = Astro.props;

const components = {
  Business: VerifiedBusiness,
  Government: VerifiedGovernment,
  Personal: VerifiedPersonal,
} as const;

const Component = type ? (components[type] ?? VerifiedPersonal) : VerifiedPersonal;
---

<Component {...props} />
