---
import type { Xitter, XitterHost } from './types';

import Info from './icons/Info.astro';
import { resolveTweetLink } from './link';
import Link from './Link.astro';

interface Props {
  tweet: Xitter;

  host: XitterHost;
  locale: Intl.LocalesArgument;
}

const { tweet, locale, host } = Astro.props;
const { created_at } = tweet;
---

<div class="astro-xitter-metadata-container">
  <Link
    title={`
      ${new Date(created_at).toLocaleString(locale, {
        hour: '2-digit',
        minute: '2-digit',
      })} · ${new Date(created_at).toLocaleString(locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })}`}
    href={resolveTweetLink(tweet, host)}
    class="astro-xitter-metadata astro-xitter-link"
  >
    {
      new Date(created_at).toLocaleString(locale, {
        hour: '2-digit',
        minute: '2-digit',
      })
    }
    &#8239;&middot;&#8239;
    {
      new Date(created_at).toLocaleString(locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    }
  </Link>

  {
    host.type === 'twitter' && (
      <Link href="https://help.x.com/en/x-for-websites-ads-info-and-privacy" class="astro-xitter-metadata-help">
        <Info class="astro-xitter-metadata-help-icon" />
      </Link>
    )
  }
</div>

<style>
  .astro-xitter-metadata-container {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: calc(8 * var(--astro-xitter-spacing));

    font-size: var(--astro-xitter-text-sm);

    color: var(--astro-xitter-subheader);

    margin-top: calc(0.5 * var(--astro-xitter-spacing));
  }

  .astro-xitter-metadata {
    line-height: 1;

    color: var(--astro-xitter-subheader);

    &:hover,
    &:focus-visible {
      text-decoration-color: var(--astro-xitter-subheader);
    }
  }

  .astro-xitter-metadata-help {
    background-color: transparent;

    border-radius: 9999px;

    transition: background-color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    width: calc(8 * var(--astro-xitter-spacing));
    height: calc(8 * var(--astro-xitter-spacing));

    display: grid;
    place-items: center;

    margin-right: calc(-1 * var(--astro-xitter-spacing));

    &:hover,
    &:focus-visible {
      background-color: color-mix(in oklch, var(--astro-xitter-blue) 10%, transparent);

      & > .astro-xitter-metadata-help-icon {
        color: var(--astro-xitter-blue);
      }
    }
  }

  .astro-xitter-metadata-help-icon {
    width: calc(5 * var(--astro-xitter-spacing));
    height: calc(5 * var(--astro-xitter-spacing));

    transition: color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    color: var(--astro-xitter-subheader);
  }
</style>
