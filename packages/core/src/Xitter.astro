---
import type { Xitter } from './types';

import { NumberFormatterOptions } from './const';
import X from './icons/X.astro';
import Link from './Link.astro';
import XitterActions from './XitterActions.astro';
import XitterCard from './XitterCard.astro';
import XitterContent from './XitterContent.astro';
import XitterHeader from './XitterHeader.astro';
import XitterMetadata from './XitterMetadata.astro';
import XitterPhotos from './XitterPhotos.astro';
import XitterQuote from './XitterQuote.astro';
import XitterVideo from './XitterVideo.astro';

interface Props {
  id: string;

  interactive?: boolean;
}

const { id, interactive = true } = Astro.props;

const url = new URL('/tweet-result', 'https://cdn.syndication.twimg.com/');
url.searchParams.set('id', id);
url.searchParams.set('token', 'x');

const result = await fetch(url);
const tweet = (await result.json()) as Xitter;

const hasCustomRenderer = Astro.slots.has('default');

const renderedContent = hasCustomRenderer
  ? await Astro.slots.render('default', [tweet])
  : null;

const locale = Astro.preferredLocale ?? Astro.currentLocale ?? 'en-US';

const { format } =new Intl.NumberFormat(locale, NumberFormatterOptions);
---

{renderedContent
  ? <Fragment set:html={renderedContent} />
  : <div class="astro-xitter-container">
    <XitterHeader tweet={tweet} />

    <XitterContent tweet={tweet} />

    {
      tweet.photos && tweet.photos.length > 0 && <XitterPhotos tweet={tweet} />
    }

    {
      tweet.video
        && <XitterVideo tweet={tweet} interactive={interactive} />
    }

    {
      tweet.quoted_tweet && (
        <XitterQuote
          tweet={tweet.quoted_tweet}
          interactive={interactive}
        />
      )
    }

    {tweet.card && <XitterCard tweet={tweet} />}

    <XitterMetadata tweet={tweet} />

    <XitterActions tweet={tweet} interactive={interactive} />

    <Link
      href={`https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}`}
      class="astro-xitter-replies"
    >
      Read {format(tweet.conversation_count)} replies
    </Link>

    <Link
      href={`https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}`}
      class="astro-xitter-badge"
    >
      <X />
    </Link>
  </div>}

{!hasCustomRenderer && <style>
.astro-xitter-container {
    --astro-xitter-blue: oklch(0.682 0.158 243.354);
    --astro-xitter-red: oklch(0.63 0.258 4.67);
    --astro-xitter-gold: oklch(0.739 0.161 85.8);
    --astro-xitter-gray: oklch(0.669 0.035 231.2);
    --astro-xitter-green: oklch(0.686 0.178 161.4);

    --astro-xitter-background: white;
    --astro-xitter-separator: oklch(0.8791 0.0129 228.95);
    --astro-xitter-content: oklch(0.1884 0.0128 248.51);
    --astro-xitter-header: black;
    --astro-xitter-subheader: oklch(0.4939 0.0294 241.16);
    --astro-xitter-blue-link: var(--astro-xitter-blue);

    --astro-xitter-spacing: 0.25rem;

    --astro-xitter-text-sm: 14px;
    --astro-xitter-text-md: 15px;
    --astro-xitter-text-lg: 20px;

    --astro-xitter-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serifsans-serif;

    --astro-xitter-transition-duration: 150ms;
    --astro-xitter-transition-easing: cubic-bezier(0.33, 1, 0.68, 1); /* easeOutCubic */

    position: relative;
    display: flex;
    flex-direction: column;
    margin: auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 550px;

    padding-right: calc(4 * var(--astro-xitter-spacing));
    padding-top: calc(3 * var(--astro-xitter-spacing));
    padding-bottom: calc(3 * var(--astro-xitter-spacing));
    padding-left: calc(4 * var(--astro-xitter-spacing));

    font-size: var(--astro-xitter-text-md);

    color: var(--astro-xitter-content);

    border-radius: calc(3 * var(--astro-xitter-spacing));
    border: 1px solid var(--astro-xitter-separator);
    background-color: var(--astro-xitter-background);

    font-family: var(--astro-xitter-font);
}

@media (prefers-color-scheme: dark) {
    .astro-xitter-container {
        --astro-xitter-background: oklch(0.2385 0.0264 248.99);
        --astro-xitter-header: white;
        --astro-xitter-content: oklch(96.7% 0.003 264.542);
        --astro-xitter-separator: oklch(0.4347 0.0354 248.65);
        --astro-xitter-subheader: oklch(0.6736 0.0244 248.19);

        --astro-xitter-blue-link: color-mix(in oklch, var(--astro-xitter-blue) 65%, white 35%);
    }
}

[data-theme="light"] .astro-xitter-container {
    --astro-xitter-background: white;
    --astro-xitter-separator: oklch(0.8791 0.0129 228.95);
    --astro-xitter-content: oklch(0.1884 0.0128 248.51);
    --astro-xitter-header: black;
    --astro-xitter-subheader: oklch(0.4939 0.0294 241.16);

    --astro-xitter-blue-link: var(--astro-xitter-blue);
}

[data-theme="dark"] .astro-xitter-container {
    --astro-xitter-background: oklch(0.2385 0.0264 248.99);
    --astro-xitter-header: white;
    --astro-xitter-content: oklch(96.7% 0.003 264.542);
    --astro-xitter-separator: oklch(0.4347 0.0354 248.65);
    --astro-xitter-subheader: oklch(0.6736 0.0244 248.19);

    --astro-xitter-blue-link: color-mix(in oklch, var(--astro-xitter-blue) 65%, white 35%);
}

.dark .astro-xitter-container {
    --astro-xitter-background: oklch(0.2385 0.0264 248.99);
    --astro-xitter-header: white;
    --astro-xitter-content: oklch(96.7% 0.003 264.542);
    --astro-xitter-separator: oklch(0.4347 0.0354 248.65);
    --astro-xitter-subheader: oklch(0.6736 0.0244 248.19);

    --astro-xitter-blue-link: color-mix(in oklch, var(--astro-xitter-blue) 65%, white 35%);
}

@media (prefers-reduced-motion: reduce) {
    .astro-xitter-container {
        --astro-xitter-transition-duration: 0ms;
    }
}

.astro-xitter-replies {
    display: grid;
    place-items: center;

    font-weight: 600;
    font-size: var(--astro-xitter-text-sm);

    padding: var(--astro-xitter-spacing);

    margin-top: var(--astro-xitter-spacing);

    border: 1px solid var(--astro-xitter-separator);
    border-radius: 9999px;

    color: var(--astro-xitter-blue-link);

    transition: background-color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    &:hover, &:focus-visible {
        background-color: color-mix(in oklch, var(--astro-xitter-blue-link) 10%, transparent);
    }
}

.astro-xitter-badge {
    position: absolute;
    top: calc(3 * var(--astro-xitter-spacing));
    right: calc(4 * var(--astro-xitter-spacing));
}
</style>}
