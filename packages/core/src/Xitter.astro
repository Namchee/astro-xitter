---
import type { Xitter } from './types';

import XitterDefault from './XitterDefault.astro';
import XitterError from './XitterError.astro';

interface Props {
  id: string;

  theme?: 'light' | 'dark';
  interactive?: boolean;
  locale?: Intl.LocalesArgument;
}

const { id, theme, interactive = true, locale } = Astro.props;

const url = new URL('/tweet-result', 'https://cdn.syndication.twimg.com/');
url.searchParams.set('id', id);
url.searchParams.set('token', 'x');

let tweet: Xitter | null = null;
let status = 200;

try {
  const result = await fetch(url);
  status = result.status;
  if (result.ok) {
    tweet = (await result.json()) as Xitter;
  }
} catch {
  // assume Internal Server Error for now
  status = 500;
}

let currentLocale = locale;

if (!locale) {
  currentLocale = Astro.currentLocale;

  if (import.meta.env.SSR && !Astro.isPrerendered) {
    currentLocale = Astro.preferredLocale ?? currentLocale;
  }

  currentLocale ??= 'en-US';
}

const hasCustomRenderer = Astro.slots.has('default');
const hasError = !tweet;

const renderedContent = hasCustomRenderer ? await Astro.slots.render('default', [tweet, status]) : null;
---

{renderedContent && <Fragment set:html={renderedContent} />}

{!renderedContent && hasError && <XitterError status={status} {...(theme === undefined ? {} : { theme })} />}

{
  !renderedContent && !hasError && tweet && (
    <XitterDefault
      tweet={tweet}
      locale={currentLocale}
      interactive={interactive}
      {...(theme === undefined ? {} : { theme })}
    />
  )
}
