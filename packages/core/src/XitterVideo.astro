---
import type { Tweet, XitterHost } from './types';

import Play from './icons/Play.astro';
import { resolveTweetLink } from './link';
import Link from './Link.astro';

interface Props {
  tweet: Tweet;

  host: XitterHost;
  interactive: boolean;
  quote?: boolean;
}

const { tweet, interactive, quote, host } = Astro.props;

const video = tweet.video?.variants
  .filter(variant => variant.type === 'application/x-mpegURL')[0]?.src!;

const rawUrl = new URL(video);
const url = `${rawUrl.origin}${rawUrl.pathname}`;
---

<div class:list={["astro-xitter-video-container", {
  "astro-xitter-quote-video-container": quote,
  "non-interactive": !interactive,
}]}>
  <video
    poster={tweet.video?.poster}
    data-video-src={url}
    preload="metadata"
    referrerpolicy="no-referrer"
    class:list={["astro-xitter-video", {
      "non-interactive": !interactive,
    }]}
    style={`aspect-ratio: ${tweet.video?.aspectRatio[0]} / ${tweet.video?.aspectRatio[1]}`} />

    <div class="astro-xitter-video-play-container">
      <button class="astro-xitter-video-play-button">
        <Play class="astro-xitter-video-play-button-icon" />
      </button>
    </div>

    {/* A fail-safe, if video streaming fails */}
    <Link aria-label={host.type === 'twitter' ? 'Watch video on X' : 'Watch video'} href={host.type === 'twitter' ? `https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}/video/1` : url} class="astro-xitter-video-link-overlay" />

    {host.type === 'twitter' && <Link class="astro-xitter-video-link" aria-label="Watch video on X" href={`https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}/video/1`}>
      Watch on X
    </Link>}

  {
    interactive && (
      <>
        <Link
          href={resolveTweetLink(tweet, host)}
          class="astro-xitter-video-replies"
          aria-hidden="true"
        >
          View Replies
        </Link>

        <div class="astro-xitter-video-context-menu" aria-hidden="true">
            <button class="astro-xitter-video-context-menu-item astro-xitter-video-context-menu-link-copy" data-video={host.type === 'twitter' ? `https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}/video/1` : url}>
                Copy Video Address
            </button>
        </div>
      </>
    )
  }
</div>

<style>
  .astro-xitter-video-container {
    position: relative;

    display: grid;
    place-items: center;

    border-radius: calc(4 * var(--astro-xitter-spacing));
    overflow: hidden;

    margin-top: calc(3 * var(--astro-xitter-spacing));

    &.astro-xitter-quote-video-container {
      border-top-left-radius: 0;
      border-top-right-radius: 0;

      border-left: 0;
      border-right: 0;
      border-bottom: 0;
    }
  }

  .astro-xitter-video {
    grid-column-start: 1;
    grid-row-start: 1;

    width: 100%;

    background: black;
  }

  .astro-xitter-video-play-container, .astro-xitter-video-link-overlay {
    width: 100%;
    height: 100%;

    display: grid;
    place-items: center;
    grid-column-start: 1;
    grid-row-start: 1;
    z-index: 1;

    &[aria-hidden="true"] {
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
    }
  }

  .astro-xitter-video-play-button {
    width: calc(16 * var(--astro-xitter-spacing));
    height: calc(16 * var(--astro-xitter-spacing));

    background: var(--astro-xitter-blue);

    border-radius: 9999px;
    border: var(--astro-xitter-spacing) solid white;

    cursor: pointer;

    filter: brightness(1);
    transition: filter var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    display: grid;
    place-items: center;

    &:hover,
    &:focus-visible {
      filter: brightness(0.9);
    }
  }

  .astro-xitter-video-play-button-icon {
    width: calc(8 * var(--astro-xitter-spacing));
    fill: white;
    stroke: white;
  }

  .astro-xitter-video-link {
    position: absolute;
    z-index: 1;
    top: calc(3 * var(--astro-xitter-spacing));
    right: calc(3 * var(--astro-xitter-spacing));

    background-color: color-mix(in oklch, black 80%, transparent);
    transition: background-color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);
    backdrop-filter: blur(5px);

    font-size: var(--astro-xitter-text-sm);
    color: white;

    padding: calc(2 * var(--astro-xitter-spacing)) calc(4 * var(--astro-xitter-spacing));

    font-weight: 600;

    border-radius: 9999px;

    &:hover,
    &:focus-visible {
      background-color: oklch(25% 0 0 / 80%);
    }

    &[aria-hidden="true"] {
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
    }
  }

  .astro-xitter-video-context-menu {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    background: var(--astro-xitter-background);
    border: 1px solid var(--astro-xitter-separator);
    border-radius: var(--astro-xitter-spacing);
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
    padding: var(--astro-xitter-spacing);

    pointer-events: none;

    visibility: hidden;
    opacity: 0;
    transform: scale(0.95);
    transform-origin: top left;
    transition:
      opacity var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing),
      transform var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing),
      visibility var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    display: flex;
    flex-direction: column;

    -webkit-tap-highlight-color: transparent;

    &[aria-hidden="false"] {
      visibility: visible;
      opacity: 1;
      transform: scale(1);
      pointer-events: all;
    }
  }

  .astro-xitter-video-context-menu-item {
    font-weight: 600;

    padding: calc(2 * var(--astro-xitter-spacing));
  }

  .astro-xitter-video-context-menu-link-copy {
    background: transparent;
    border: none;
  }

  .astro-xitter-video-replies {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translateX(-50%) translateY(-100%);

    display: none;
    visibility: hidden;

    z-index: 1;

    color: white;
    font-weight: 600;

    background: var(--astro-xitter-blue);

    border-radius: 9999px;

    padding: var(--astro-xitter-spacing) calc(4 * var(--astro-xitter-spacing));

    cursor: pointer;

    filter: brightness(1);
    transition: filter var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    &[aria-hidden='false'] {
      display: block;
      visibility: visible;
    }

    &:hover,
    &:focus-visible {
      filter: brightness(0.9);
    }
  }
</style>

{interactive && <script>
  import { streamVideo } from './video';

  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-video-src]');
  for (const video of videos) {
    const src = video.dataset.videoSrc;

    const overlay = video.parentElement?.querySelector('.astro-xitter-video-link-overlay');

    streamVideo(video, src ?? '', overlay as HTMLAnchorElement);
  }

  const playTrigger = document.querySelectorAll('.astro-xitter-video-play-container');

  for (const trigger of playTrigger) {
    trigger.addEventListener('click', () => {
      const t = trigger as HTMLButtonElement;
      const par = trigger.parentElement;
      if (!par) {
        return;
      }

      const vid = par.querySelector('video');
      const vidLink = par.querySelector('.astro-xitter-video-link');
      const vidReply = par.querySelector('.astro-xitter-video-replies');

      if (!vid) {
        return;
      }

      vid.setAttribute('controls', 'true');
      vid.play().catch(() => {
        // Ignore autoplay rejections; the source may not be ready yet.
      });

      t.setAttribute('aria-hidden', 'true');

      if (vidLink) {
        const link = vidLink as HTMLAnchorElement;

        link.setAttribute('aria-hidden', 'true');

        vid.addEventListener('pause', () => {
          if (!vid.ended) {
            link.textContent = 'Continue watching on X';
            link.setAttribute('aria-hidden', 'false');
          }
        });

        vid.addEventListener('play', () => {
          link.setAttribute('aria-hidden', 'true');
        });
      }

      if (vidReply) {
        vid.addEventListener('ended', () => {
          vidReply.setAttribute('aria-hidden', 'false');
        });

        vid.addEventListener('play', () => {
          vidReply.setAttribute('aria-hidden', 'true');
        });
      }
    });
  }

  const videoContainers = document.querySelectorAll('.astro-xitter-video-container');
  const ctxMenus = document.querySelectorAll('.astro-xitter-video-context-menu');
  const copyLinks = document.querySelectorAll('.astro-xitter-video-context-menu-link-copy');

  function positionMenu(el: HTMLElement, clientX: number, clientY: number) {
    const menuWidth = el.offsetWidth;
    const menuHeight = el.offsetHeight;

    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;
    const padding = 8;

    let x = clientX;
    let y = clientY;

    if (x + menuWidth > viewportWidth - padding) {
      x = Math.max(padding, viewportWidth - menuWidth - padding);
    }

    if (y + menuHeight > viewportHeight - padding) {
      y = Math.max(padding, viewportHeight - menuHeight - padding);
    }

    el.style.left = `${x}px`;
    el.style.top = `${y}px`;
    el.style.display = '';

    el.setAttribute('aria-hidden', 'false');
    el.focus();
  }

  function closeContextMenu(el: HTMLElement) {
    el.setAttribute('aria-hidden', 'true');
  }

  for (const c of videoContainers) {
    const container = c as HTMLDivElement;

    container.addEventListener('contextmenu', e => {
      e.preventDefault();
      e.stopPropagation();

      const menu = container.querySelector('.astro-xitter-video-context-menu');

      if (menu) {
        positionMenu(menu as HTMLElement, e.clientX, e.clientY);
      }
    });
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      for (const menu of ctxMenus) {
        closeContextMenu(menu as HTMLElement);
      }
    }
  });

  document.addEventListener(
    'pointerdown',
    e => {
      for (const menu of ctxMenus) {
        if (!e.target) {
          return;
        }

        if (!menu.contains(e.target as HTMLElement) && menu.getAttribute('aria-hidden') === 'false') {
          closeContextMenu(menu as HTMLElement);
        }
      }
    },
    true,
  );

  for (const copyLink of copyLinks) {
    const btn = copyLink as HTMLButtonElement;

    btn.addEventListener('click', async () => {
      const link = btn.dataset.video;
      if (!link) {
        return;
      }

      await navigator.clipboard.writeText(link);

      for (const menu of ctxMenus) {
        closeContextMenu(menu as HTMLElement);
      }
    });
  }
</script>}
