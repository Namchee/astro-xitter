---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { rel, ...props } = Astro.props;

let target = '_self';

if (props.href?.toString().startsWith('http')) {
  target = '_blank';
}
---

<a
  rel={['noopener noreferrer', rel].filter(Boolean).join(' ')}
  target={target}
  data-astro-prefetch={target === '_self' ? true : false}
  class:list={['astro-xitter-link', props.class]}
  {...props}
>
  <slot />
</a>

<style>
  .astro-xitter-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);
  }
</style>
