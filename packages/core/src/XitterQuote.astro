---
import type { Xitter } from './types';

import { XitterUserVerifiedType } from './const';
import Verified from './icons/Verified.astro';
import { processContent } from './lib';
import Link from './Link.astro';
import XitterPhotos from './XitterPhotos.astro';
import XitterVideo from './XitterVideo.astro';

interface Props {
  tweet: Xitter;

  interactive: boolean;
}

const { tweet, interactive } = Astro.props;
const { user } = tweet;

const isVerified =
  user.is_blue_verified || user.verified || ['Business', 'Government'].includes(user.verified_type ?? '');

const { content } = processContent(tweet);
---

<article class="astro-xitter-quote-container">
  <Link title="View Post" href={`https://x.com/${user.screen_name}/status/${tweet.id_str}`}>
    <div class="astro-xitter-quote-heading">
      <img
        src={user.profile_image_url_https}
        class:list={[
          'astro-xitter-quote-avatar',
          {
            'astro-xitter-quote-avatar-square': user.profile_image_shape === 'Square',
          },
        ]}
      />

      <div class="astro-xitter-quote-profile">
        <span class="astro-xitter-quote-profile-name">
          {user.name}
        </span>
        {
          isVerified && (
            <Verified
              type={user.verified_type}
              class:list={[
                'astro-xitter-quote-profile-verified-badge',
                {
                  'astro-xitter-profile-verified-business': user.verified_type === XitterUserVerifiedType.Business,
                  'astro-xitter-profile-verified-government': user.verified_type === XitterUserVerifiedType.Government,
                  'astro-xitter-profile-verified-personal':
                    user.verified_type !== XitterUserVerifiedType.Business &&
                    user.verified_type !== XitterUserVerifiedType.Government,
                },
              ]}
            />
          )
        }

        <div class="astro-xitter-quote-profile-screen">
          <span class="astro-xitter-quote-profile-screen-name">
            @{user.screen_name}
          </span>

          <span class="astro-xitter-quote-profile-separator">&middot;</span>

          <span class="astro-xitter-quote-profile-created-at">
            {
              new Date(tweet.created_at).toLocaleString('en-US', {
                day: 'numeric',
                month: 'short',
                year: 'numeric',
              })
            }
          </span>
        </div>
      </div>
    </div>

    <p class="astro-xitter-quote-content">
      <Fragment set:html={content} />
    </p>
  </Link>

  {(tweet.photos?.length ?? 0) > 0 && <XitterPhotos tweet={tweet} quote />}

  {tweet.video && <XitterVideo tweet={tweet} interactive={interactive} quote />}
</article>

<style>
  .astro-xitter-quote-container {
    border: 1px solid var(--astro-xitter-separator);
    border-radius: calc(4 * var(--astro-xitter-spacing));

    overflow: hidden;

    transition: background-color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    margin-top: calc(3 * var(--astro-xitter-spacing));

    background-color: var(--astro-xitter-background);
    transition: background-color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    border-collapse: collapse;

    position: relative;

    &:hover,
    &:focus-visible {
      background-color: color-mix(in oklch, var(--astro-xitter-background) 97.5%, black);
    }
  }

  .astro-xitter-quote-heading {
    line-height: 1;

    display: flex;
    align-items: center;
    gap: calc(2 * var(--astro-xitter-spacing));

    padding-top: calc(3 * var(--astro-xitter-spacing));
    padding-left: calc(3 * var(--astro-xitter-spacing));
    padding-right: calc(3 * var(--astro-xitter-spacing));
  }

  .astro-xitter-quote-avatar {
    width: calc(5 * var(--astro-xitter-spacing));
    height: calc(5 * var(--astro-xitter-spacing));

    border-radius: 9999px;

    flex-shrink: 0;

    &.astro-xitter-quote-avatar-square {
      border-radius: calc(4 * var(--astro-xitter-spacing));
    }
  }

  .astro-xitter-quote-profile {
    display: flex;
    align-items: center;

    line-height: 1;

    margin: 0;
  }

  .astro-xitter-quote-profile-screen {
    display: flex;
    align-items: center;
    line-height: 1;
    gap: var(--astro-xitter-spacing);
    color: var(--astro-xitter-subheader);

    margin: 0;
  }

  .astro-xitter-quote-profile-name {
    font-weight: 600;
    font-size: var(--astro-xitter-text-sm);
    color: var(--astro-xitter-header);

    margin-right: calc(0.5 * var(--astro-xitter-spacing));
  }

  .astro-xitter-quote-profile-verified-badge {
    flex-shrink: 0;
    width: calc(4.5 * var(--astro-xitter-spacing));
    height: auto;

    &.astro-xitter-profile-verified-government {
      color: var(--astro-xitter-gray);
    }

    &.astro-xitter-profile-verified-personal {
      color: var(--astro-xitter-blue);
    }
  }

  .astro-xitter-quote-profile-screen-name {
    color: var(--astro-xitter-subheader);

    font-size: var(--astro-xitter-text-sm);
    line-height: 1;

    margin-left: var(--astro-xitter-spacing);
    maring-right: var(--astro-xitter-spacing);
  }

  .astro-xitter-quote-profile-created-at {
    color: var(--astro-xitter-subheader);

    font-size: var(--astro-xitter-text-sm);
    line-height: 1;
  }

  .astro-xitter-quote-content {
    white-space: pre-wrap;
    line-height: calc(5 * var(--astro-xitter-spacing) / var(--astro-xitter-text-md));
    font-size: var(--astro-xitter-text-md);

    margin-top: var(--astro-xitter-spacing);
    margin-bottom: calc(3 * var(--astro-xitter-spacing));

    color: var(--astro-xitter-content);

    padding-left: calc(3 * var(--astro-xitter-spacing));
    padding-right: calc(3 * var(--astro-xitter-spacing));

    &.astro-xitter-quote-content-last {
      padding-bottom: calc(3 * var(--astro-xitter-spacing));
    }
  }

  @media (prefers-color-scheme: dark) {
    .astro-xitter-quote-container {
      &:hover,
      &:focus-visible {
        background-color: color-mix(in oklch, var(--astro-xitter-background) 95%, white);
      }
    }
  }

  :global([data-theme='dark']) .astro-xitter-quote-container {
    &:hover,
    &:focus-visible {
      background-color: color-mix(in oklch, var(--astro-xitter-background) 95%, white);
    }
  }

  :global([data-theme='light']) .astro-xitter-quote-container {
    &:hover,
    &:focus-visible {
      background-color: color-mix(in oklch, var(--astro-xitter-background) 97.5%, black);
    }
  }

  :global(.astro-xitter-container.dark) .astro-xitter-quote-container {
    &:hover,
    &:focus-visible {
      background-color: color-mix(in oklch, var(--astro-xitter-background) 95%, white);
    }
  }
</style>
