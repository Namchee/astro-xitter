---
import { ErrorCode } from './const';

interface Props {
  status: number;

  theme?: 'light' | 'dark';
}

const { status, theme } = Astro.props;

const ErrorText = {
  [ErrorCode.Deleted]: {
    title: 'Tweet has been deleted',
    description: 'This tweet has been deleted by the author and cannot be rendered',
  },
  [ErrorCode.NotFound]: {
    title: 'Tweet not found',
    description: 'The requested tweet could not be found',
  },
};
---

<div
  class:list={[
    'astro-xitter-error-container',
    {
      dark: theme === 'dark',
      light: theme === 'light',
    },
  ]}
>
  <h1 class="astro-xitter-error-title">
    {ErrorText[status]?.title ?? 'Unknown Error'}
  </h1>

  <p class="astro-xitter-error-description">
    {ErrorText[status]?.description ?? 'Failed to fetch tweet due to unexpected error'}
  </p>
</div>

<style>
  .astro-xitter-error-container {
    --astro-xitter-spacing: 0.25rem;

    --astro-xitter-text-sm: 14px;
    --astro-xitter-text-md: 15px;
    --astro-xitter-text-lg: 20px;

    --astro-xitter-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;

    --astro-xitter-background: white;
    --astro-xitter-separator: oklch(0.8791 0.0129 228.95);
    --astro-xitter-content: oklch(0.1884 0.0128 248.51);
    --astro-xitter-header: black;
    --astro-xitter-subheader: oklch(0.4939 0.0294 241.16);

    position: relative;
    display: flex;
    flex-direction: column;
    margin: auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 550px;

    padding: calc(3 * var(--astro-xitter-spacing)) calc(4 * var(--astro-xitter-spacing));

    font-size: var(--astro-xitter-text-md);

    color: var(--astro-xitter-content);

    border-radius: calc(3 * var(--astro-xitter-spacing));
    border: 1px solid var(--astro-xitter-separator);
    background-color: var(--astro-xitter-background);

    font-family: var(--astro-xitter-font);

    gap: calc(2 * var(--astro-xitter-spacing));
    align-items: center;
  }

  @media (prefers-color-scheme: dark) {
    .astro-xitter-error-container {
      --astro-xitter-background: oklch(0.2385 0.0264 248.99);
      --astro-xitter-header: white;
      --astro-xitter-content: oklch(96.7% 0.003 264.542);
      --astro-xitter-separator: oklch(0.4347 0.0354 248.65);
      --astro-xitter-subheader: oklch(0.6736 0.0244 248.19);
    }
  }

  :global([data-theme='light']) .astro-xitter-error-container {
    --astro-xitter-background: white;
    --astro-xitter-separator: oklch(0.8791 0.0129 228.95);
    --astro-xitter-content: oklch(0.1884 0.0128 248.51);
    --astro-xitter-header: black;
    --astro-xitter-subheader: oklch(0.4939 0.0294 241.16);

    --astro-xitter-link: oklch(0.549044 0.179255 254.7525);
  }

  :global([data-theme='dark']) .astro-xitter-error-container {
    --astro-xitter-background: oklch(0.2385 0.0264 248.99);
    --astro-xitter-header: white;
    --astro-xitter-content: oklch(96.7% 0.003 264.542);
    --astro-xitter-separator: oklch(0.4347 0.0354 248.65);
    --astro-xitter-subheader: oklch(0.6736 0.0244 248.19);

    --astro-xitter-link: color-mix(in oklch, var(--astro-xitter-blue) 65%, white 35%);
  }

  .astro-xitter-error-container.light {
    --astro-xitter-background: oklch(0.2385 0.0264 248.99);
    --astro-xitter-header: white;
    --astro-xitter-content: oklch(96.7% 0.003 264.542);
    --astro-xitter-separator: oklch(0.4347 0.0354 248.65);
    --astro-xitter-subheader: oklch(0.6736 0.0244 248.19);

    --astro-xitter-link: color-mix(in oklch, var(--astro-xitter-blue) 65%, white 35%);
  }

  .astro-xitter-error-container.dark {
    --astro-xitter-background: oklch(0.2385 0.0264 248.99);
    --astro-xitter-header: white;
    --astro-xitter-content: oklch(96.7% 0.003 264.542);
    --astro-xitter-separator: oklch(0.4347 0.0354 248.65);
    --astro-xitter-subheader: oklch(0.6736 0.0244 248.19);

    --astro-xitter-link: color-mix(in oklch, var(--astro-xitter-blue) 65%, white 35%);
  }

  .astro-xitter-error-title {
    font-weight: 600;
    font-size: var(--astro-xitter-text-lg);
  }

  .astro-xitter-error-description {
    margin: 0;
  }
</style>
