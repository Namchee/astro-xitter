---
import type { Tweet, XitterHost } from './types';

import { Image } from 'astro:assets';

import { resolvePhotoLink } from './link';
import Link from './Link.astro';

interface Props {
  tweet: Tweet;

  host: XitterHost;
  quote?: boolean;
}

const { tweet, quote, host } = Astro.props;
const photos = tweet.photos ?? [];
---

<div
  class:list={[
    'astro-xitter-photo-container',
    {
      'astro-xitter-photo-container-one': photos.length === 1,
      'astro-xitter-photo-container-two': photos.length === 2,
      'astro-xitter-photo-container-bento': photos.length ?? 0 >= 3,
      'astro-xitter-quote-photo-container': quote,
    },
  ]}
>
  {
    photos.slice(0, 4).map((p, i) => (
      <Link
        class:list={[
          'astro-xitter-photo-link',
          {
            'astro-xitter-photo-link-one': photos.length === 1,
            'astro-xitter-photo-link-bento': (photos.length === 3 && i === 0) || photos.length === 2,
          },
        ]}
        href={resolvePhotoLink(tweet, host, i)}
      >
        <Image
          width={p.width}
          height={p.height}
          alt={resolvePhotoLink(tweet, host, i)}
          src={p.url}
          draggable="true"
          class="astro-xitter-photo"
        />
      </Link>
    ))
  }
</div>

<style>
  .astro-xitter-photo-container {
    display: grid;
    gap: calc(0.5 * var(--astro-xitter-spacing));

    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;

    margin-top: calc(3 * var(--astro-xitter-spacing));
    border-radius: calc(4 * var(--astro-xitter-spacing));

    border: 1px solid var(--astro-xitter-separator);

    &.astro-xitter-photo-container-one {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    &.astro-xitter-photo-container-two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    &.astro-xitter-photo-container-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }

    &.astro-xitter-quote-photo-container {
      border-top-left-radius: 0;
      border-top-right-radius: 0;

      border-left: 0;
      border-right: 0;
      border-bottom: 0;
    }
  }

  .astro-xitter-photo-link-one {
    grid-row: span 2;
    grid-column: span 2;
  }

  .astro-xitter-photo-link-bento {
    grid-row: span 2;
  }

  .astro-xitter-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
