---
import type { Xitter } from './types';

import { NumberFormatterOptions } from './const';
import Chain from './icons/Chain.astro';
import Checkmark from './icons/Checkmark.astro';
import Heart from './icons/Heart.astro';
import Reply from './icons/Reply.astro';
import Link from './Link.astro';

interface Props {
  tweet: Xitter;

  interactive: boolean;
}

const { tweet, interactive } = Astro.props;

const locale = Astro.preferredLocale ?? Astro.currentLocale ?? 'en-US';

const { format } = new Intl.NumberFormat(locale, NumberFormatterOptions);
---

<div class="astro-xitter-actions-container">
  <Link
    title="Like this Tweet"
    class="astro-xitter-actions-link"
    href={`https://x.com/intent/like?tweet_id=${tweet.id_str}`}
  >
    <div class="astro-xitter-actions-link-icon-container astro-xitter-actions-link-icon-like-container">
      <Heart class="astro-xitter-actions-link-icon astro-xitter-actions-link-icon-like" />
    </div>

    <span class="astro-xitter-actions-link-label astro-xitter-actions-link-label-like">
      {format(tweet.favorite_count)}
    </span>
  </Link>

  <Link
    title="Reply this Tweet"
    class="astro-xitter-actions-link"
    href={`https://x.com/intent/tweet?in_reply_to=${tweet.id_str}`}
  >
    <div class="astro-xitter-actions-link-icon-container astro-xitter-actions-link-icon-reply-container">
      <Reply class="astro-xitter-actions-link-icon astro-xitter-actions-link-icon-reply" />
    </div>

    <span class="astro-xitter-actions-link-label astro-xitter-actions-link-label-reply">
      Reply
    </span>
  </Link>

  {interactive && <button
    title="Share this Tweet"
    class="astro-xitter-actions-link astro-xitter-actions-copy-button"
    data-tweet={`https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}`}
  >
    <div
      class="astro-xitter-actions-link-icon-container astro-xitter-actions-link-icon-copy-container"
    >
      <Chain
        class="astro-xitter-actions-link-icon astro-xitter-actions-link-icon-copy"
      />
      <Checkmark class="astro-xitter-actions-link-icon astro-xitter-actions-link-icon-check hidden" />
    </div>

    <span class="astro-xitter-actions-link-label astro-xitter-actions-link-label-copy">
      Copy Link
    </span>
  </button>}
</div>

<style>
.astro-xitter-actions-container {
    margin-top: var(--astro-xitter-spacing);

    padding-top: var(--astro-xitter-spacing);

    display: flex;
    align-items: center;
    gap: calc(5 * var(--astro-xitter-spacing));

    border-top: 1px solid var(--astro-xitter-separator);
}

.astro-xitter-actions-link {
    display: flex;
    align-items: center;
    gap: var(--astro-xitter-spacing);

    & .astro-xitter-actions-link-icon-like {
        color: var(--astro-xitter-red);
    }

    & .astro-xitter-actions-link-icon-reply {
        color: var(--astro-xitter-blue);
    }

    & .astro-xitter-actions-link-icon-copy {
        color: var(--astro-xitter-subheader);
    }

    & .astro-xitter-actions-link-icon-check {
        color: var(--astro-xitter-subheader);
    }

    &:first-child {
        margin-left: calc(-1 * var(--astro-xitter-spacing));
    }

    &:hover, &:focus-visible {
        & > .astro-xitter-actions-link-icon-like-container {
            background-color: color-mix(in oklch, var(--astro-xitter-red) 10%, transparent);
        }

        & > .astro-xitter-actions-link-label-like {
            color: var(--astro-xitter-red);
            text-decoration-color: var(--astro-xitter-red);
        }

        & > .astro-xitter-actions-link-icon-reply-container {
            background-color: color-mix(in oklch, var(--astro-xitter-blue) 10%, transparent);
        }

        & > .astro-xitter-actions-link-label-reply {
            color: var(--astro-xitter-blue);
            text-decoration-color: var(--astro-xitter-blue);
        }

        & > .astro-xitter-actions-link-icon-copy-container {
            background-color: color-mix(in oklch, var(--astro-xitter-green) 10%, transparent);
        }

        & .astro-xitter-actions-link-icon-copy {
            color: var(--astro-xitter-green);
        }

        & .astro-xitter-actions-link-label-copy {
            color: var(--astro-xitter-green);
            text-decoration-color: var(--astro-xitter-green);
        }
    }
}

.astro-xitter-actions-link-icon-container {
    width: calc(8 * var(--astro-xitter-spacing));
    height: calc(8 * var(--astro-xitter-spacing));

    display: grid;
    place-items: center;

    border-radius: 9999px;
    background-color: transparent;

    transition: background-color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);
}

.astro-xitter-actions-link-icon {
    flex-shrink: 0;

    width: calc(5 * var(--astro-xitter-spacing));
    height: auto;

    transition: color var(--astro-xitter-transition-duration) var(--astro-xitter-transition-easing);

    &.hidden {
        display: none;
    }
}

.astro-xitter-actions-link-label {
    font-weight: 600;
    font-size: var(--astro-xitter-text-sm);
    line-height: calc(4 * var(--astro-xitter-spacing));

    color: var(--astro-xitter-subheader);

    text-decoration: underline;
    text-decoration-color: transparent;

    transition: text-decoration-color 0ms var(--astro-xitter-easing-timing);
}

.astro-xitter-actions-copy-button {
    cursor: pointer;

    display: flex;
    align-items: center;

    background: transparent;
    border: none;
    outline: none;

    padding: 0;

    &:disabled {
        cursor: default;

        & > .astro-xitter-actions-link-copy-icon {
            stroke: var(--astro-xitter-subheader);
        }

        & > .astro-xitter-actions-link-label {
            color: var(--astro-xitter-subheader);
            text-decoration-color: transparent;
        }

        & > .astro-xitter-actions-link-icon-container {
            background: transparent;
        }
    }
}
</style>

{interactive && <script>
  const buttons = document.querySelectorAll('.astro-xitter-actions-copy-button');

  for (const b of buttons) {
    const button = b as HTMLButtonElement;

    button.addEventListener('click', async () => {
      const tweet = button.dataset.tweet;
      const copy = button.querySelector('.astro-xitter-actions-link-icon-copy');
      const check = button.querySelector('.astro-xitter-actions-link-icon-check');
      const text = button.querySelector('span');

      if (!navigator.clipboard || !tweet || !copy || !check || !text) {
        return;
      }

      await navigator.clipboard.writeText(tweet);

      text.textContent = 'Copied!';
      copy.classList.toggle('hidden');
      check.classList.toggle('hidden');
      button.disabled = true;

      setTimeout(() => {
        text.textContent = 'Copy Link';
        copy.classList.toggle('hidden');
        check.classList.toggle('hidden');
        button.disabled = false;
      }, 3_000);
    });
  }
</script>}
