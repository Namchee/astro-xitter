---
---

<form id="tweet-form" class="tweet-form">
  <label for="tweet-id">Post ID</label>
  <div class="tweet-form-row">
    <input
      id="tweet-id"
      name="id"
      type="text"
      inputmode="numeric"
      pattern="[0-9]+"
      placeholder="e.g. 1771177501575753762"
      required
    />
    <button type="submit">Load post</button>
  </div>
</form>

<p class="tweet-form-hint">
  You can also visit <code>/demo/tweet/&lt;id&gt;</code> directly.
</p>

<script>
  const form = document.querySelector('#tweet-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const id = new FormData(form).get('id')?.toString().trim();
    if (id) {
      window.location.href = `/demo/tweet/${encodeURIComponent(id)}`;
    }
  });
</script>

<style>
  .tweet-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1.5rem 0 0.5rem;
  }

  .tweet-form label {
    font-weight: 600;
  }

  .tweet-form-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tweet-form input {
    flex: 1 1 16rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }

  .tweet-form button {
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
    cursor: pointer;
  }

  .tweet-form-hint {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
