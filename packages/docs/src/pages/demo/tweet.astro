---
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Xitter, XitterLoading } from 'astro-xitter';

export const prerender = false;

const id = Astro.url.searchParams.get('id');
---

<StarlightPage frontmatter={{ title: 'Dynamic Tweet Demo' }}>
  <p>
    This page is a dynamic demo of <code>astro-xitter</code>, where you can request Tweet to be rendered on-demand
    instead of being statically generated.
  </p>

  <p>
    To render a tweet, fill out the following form with the Tweet ID click the <code>Render</code> button. You can also supply
    it directly in the URL with <code>id</code> query parameter. For example, <code>/demo/tweet?id=20</code>.
  </p>

  <div>
    <form id="tweet-form" class="astro-xitter-dynamic-demo-form">
      <label for="tweet-id">Post ID<span class="astro-xitter-dynamic-demo-form-section-label-required">*</span></label>

      <div class="astro-xitter-dynamic-demo-form-section">
        <input
          id="tweet-id"
          name="id"
          type="text"
          inputmode="numeric"
          pattern="[0-9]+"
          placeholder="e.g. 1771177501575753762"
          required
          value={id ?? ''}
        />

        <button type="submit" class="astro-xitter-dynamic-demo-form-submit"> Render </button>
      </div>
    </form>
  </div>

  <div class="astro-xitter-dynamic-demo-result">
    <AnchorHeading level="5" id="tweet-preview">Tweet Preview</AnchorHeading>

    {
      id ? (
        <Xitter id={id} server:defer>
          <XitterLoading slot="fallback" />
        </Xitter>
      ) : (
        <div class="astro-xitter-dynamic-demo-result-placeholder">
          Tweet will be embedded here once Tweet ID is filled
        </div>
      )
    }
  </div>
</StarlightPage>

<style>
  .astro-xitter-dynamic-demo-form {
    margin: 1.5rem 0 0.5rem;

    display: flex;
    flex-direction: column;

    & :first-child {
      flex: 1;
    }

    & .astro-xitter-dynamic-demo-form-submit {
      margin: 0;
      margin-bottom: 1px;
      border-radius: 0.375rem;
      border: 1px solid var(--sl-color-gray-5);

      background: var(--sl-color-accent);
      color: var(--sl-badge-default-text);

      font-weight: 500;

      cursor: pointer;

      padding: 0.5rem 1.5rem;
    }

    & .astro-xitter-dynamic-demo-form-section {
      display: flex;
      gap: 0.5rem;
    }

    & .astro-xitter-dynamic-demo-form-section-label-required {
      color: var(--sl-color-red);
    }

    & label {
      font-weight: 600;
    }

    & input {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.375rem;
      background: var(--sl-color-black);
      color: var(--sl-color-white);

      box-sizing: border-box;
    }
  }

  .astro-xitter-dynamic-demo-result {
    margin-top: 4rem;

    display: flex;
    flex-direction: column;

    gap: 1rem;
  }

  .astro-xitter-dynamic-demo-result-placeholder {
    width: 100%;
    height: 100%;

    padding: 2rem;

    display: grid;
    place-items: center;

    color: var(--sl-color-gray-4);
  }
</style>

<script>
  const form = document.querySelector('#tweet-form');

  if (form) {
    form.addEventListener('submit', event => {
      event.preventDefault();

      const target = event.currentTarget as HTMLFormElement;

      const id = new FormData(target).get('id')?.toString().trim();
      if (id) {
        window.location.href = `/demo/tweet?id=${encodeURIComponent(id)}`;
      }
    });
  }
</script>
