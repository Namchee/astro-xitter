---
import type { Xitter, XitterHost } from '@/types';

import Chain from '@/icons/Chain.astro';
import Checkmark from '@/icons/Checkmark.astro';
import Heart from '@/icons/Heart.astro';
import Info from '@/icons/Info.astro';
import Nitter from '@/icons/Nitter.astro';
import Play from '@/icons/Play.astro';
import Reply from '@/icons/Reply.astro';
import Verified from '@/icons/Verified.astro';
import X from '@/icons/X.astro';
import Link from '@/Link.astro';
import { XitterUserVerifiedType } from '@/types';

import Quote from './Quote.astro';

interface Props {
  id: string;
  host?: XitterHost;
}

const { id, host = { type: 'x' } } = Astro.props;

const HostLabelMap = {
  x: 'X',
  nitter: 'Nitter',
};
const HostIconMap = {
  x: X,
  nitter: Nitter,
};

const hostname = host.type === 'x' ? 'https://x.com' : host.host;

const url = new URL('/tweet-result', 'https://cdn.syndication.twimg.com/');
url.searchParams.set('id', id);
url.searchParams.set('token', 'x');

const result = await fetch(url);
const tweet = (await result.json()) as Xitter;

const numberFormatter = new Intl.NumberFormat('en-US', {
  style: 'decimal',
  notation: 'compact',
  compactDisplay: 'short',
  minimumFractionDigits: 0,
  maximumFractionDigits: 1,
});

const entityRegex = /https:\/\/t.co\/.+$/v;
const videoRegex = /\/vid\/[^\/]+\/(?<width>\d+)x\d+/v;
tweet.text = tweet.text.replace(entityRegex, '').trim();

const isTruncated = !!tweet.note_tweet;

const Icon = HostIconMap[host.type];

const hasCustomRenderer = Astro.slots.has('default');

const renderedContent = hasCustomRenderer
  ? await Astro.slots.render('default', [tweet])
  : null;

const videoUrl = tweet.video?.variants
  .filter(variant => variant.type === 'video/mp4')
  .sort((a, b) => {
    const widthA = Number(videoRegex.exec(a.src)?.groups?.width ?? 0);
    const widthB = Number(videoRegex.exec(b.src)?.groups?.width ?? 0);
    return widthB - widthA;
  })[0]?.src;
---

{renderedContent
  ? <Fragment set:html={renderedContent} />
  : <div class="astro-xitter-container">
    <div class="astro-xitter-header-container">
      <Link
        title={`View Profile on ${HostLabelMap[host.type]}`}
        href={`${hostname}/${tweet.user.screen_name}`}
        class="astro-xitter-profile-picture"
      >
        <img
          src={tweet.user.profile_image_url_https}
          class:list={[
            'astro-xitter-profile-avatar',
            {
              'astro-xitter-profile-avatar-square': tweet.user.profile_image_shape === 'Square',
            },
          ]}
        />
      </Link>

      <div class="astro-xitter-profile">
        <Link
          title={`View Profile on ${HostLabelMap[host.type]}`}
          class="astro-xitter-profile-name astro-xitter-link"
          href={`${hostname}/${tweet.user.screen_name}`}
        >{tweet.user.name}

          {
            (tweet.user.is_blue_verified || tweet.user.verified) && (
              <Verified class:list={['astro-xitter-profile-verified-badge', {
                'astro-xitter-profile-verified-business': tweet.user.verified_type === XitterUserVerifiedType.Business,
                'astro-xitter-profile-verified-government': tweet.user.verified_type === XitterUserVerifiedType.Government,
                'astro-xitter-profile-verified-personal': ![XitterUserVerifiedType.Business, XitterUserVerifiedType.Government].includes(tweet.user.verified_type),
              }]} />
            )
          }</Link
        >

        <div class="astro-xitter-profile-screen">
          <Link
            title={`View Profile on ${HostLabelMap[host.type]}`}
            href={`${hostname}/${tweet.user.screen_name}`}
            class="astro-xitter-profile-screen-name"
          >
            @{tweet.user.screen_name}
          </Link>

          {host.type === 'x' && <>
            &middot;

            <Link
              class="astro-xitter-profile-screen-follow astro-xitter-link"
              href={`https://x.com/intent/follow?screen_name=${tweet.user.screen_name}`}
            >
              Follow
            </Link>
          </>}
        </div>
      </div>
    </div>

    <p class="astro-xitter-content">
      {tweet.text}
      {
        isTruncated && (
          <>
            <>... </>
            <Link
              class="text-twitter-blue underline underline-offset-2 underline-transparent hover:underline-twitter-blue transition-colors"
              href={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
            >
              Show More
            </Link>
          </>
        )
      }
    </p>

    {
      tweet.photos && tweet.photos.length > 0 && (
        <div
          class:list={[
            'grid gap-0.5 overflow-hidden rounded-2xl w-full aspect-[16/9] mb-3',
            {
              'grid-cols-1': tweet.photos.length === 1,
              'grid-cols-2': tweet.photos.length === 2,
              'grid-cols-2 grid-rows-2': tweet.photos.length >= 3,
            },
          ]}
        >
          {tweet.photos.slice(0, 4).map((p, i) => (
            <Link
              class:list={[
                {
                  'row-span-2': tweet.photos?.length === 3 && i === 0,
                },
              ]}
              href={`https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}/photo/${i + 1}`}
            >
              <img
                src={p.url}
                class="h-full w-full object-cover"
              />
            </Link>
          ))}
        </div>
      )
    }

    {
      tweet.video && (
        <div class="relative grid place-items-center">
          <video
            src={videoUrl}
            poster={tweet.video.poster}
            referrerpolicy="no-referrer"
            class="w-full mb-[6px] rounded-2xl bg-black col-start-1 row-start-1"
            style={`aspect-ratio: ${tweet.video.aspectRatio[0]} / ${tweet.video.aspectRatio[1]}`}
          />

          <button class="size-16 col-start-1 row-start-1 z-10 bg-twitter-blue rounded-full border-4 grid place-items-center border-white hover:brightness-90 transition-all cursor-pointer play__button">
            <Play class="size-8 fill-white stroke-white" />
          </button>

          {host.type === 'x' && (
            <Link
              class="absolute z-10 top-4 right-4 bg-black/25 hover:brightness-105 transition-all backdrop-blur-sm text-sm text-white py-2 px-4 font-semibold rounded-full text-sm"
              href={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
            >
              Watch on X
            </Link>
          )}
        </div>
      )
    }

    {
      tweet.quoted_tweet && (
        <Quote
          tweet={tweet.quoted_tweet}
          host={host}
        />
      )
    }

    <div class="flex items-center justify-between text-sm text-content/70 mb-[6px]">
      <Link
        href={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
        class="underline underline-offset-2 underline-transparent hover:underline-content/70 transition-colors leading-none"
      >
        {
          new Date(tweet.created_at).toLocaleString('en-US', {
            hour: '2-digit',
            minute: '2-digit',
          })
        }
      &#8239;&middot;&#8239;
        {
          new Date(tweet.created_at).toLocaleString('en-US', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          })
        }
      </Link>

      {
        host === 'https://x.com' && (
          <Link
            href="https://help.x.com/en/x-for-websites-ads-info-and-privacy"
            class="group hover:bg-twitter-blue/10 p-[6px] rounded-full transition-colors"
          >
            <Info class="size-4 text-content/70 group-hover:text-twitter-blue transition-colors" />
          </Link>
        )
      }
    </div>

    <div class="h-px w-full border border-separator/50 mb-[6px]"></div>

    <div class="mb-[6px]">
      <div class="flex items-center gap-2">
        <Link
          title="Like this Tweet"
          class="flex items-center group gap-0.5"
          href={`https://x.com/intent/like?tweet_id=${tweet.id_str}`}
        >
          <div class="p-[6px] rounded-full bg-transparent group-hover:bg-twitter-red/10 transition-colors">
            <Heart class="size-4 text-twitter-red" />
          </div>
          <span
            class="font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-red transition-colors group-hover:text-twitter-red"
          >{numberFormatter.format(tweet.favorite_count)}</span
          >
        </Link>

        <Link
          title="Reply this Tweet"
          class="flex items-center group gap-0.5"
          href={`https://x.com/intent/tweet?in_reply_to=${tweet.id_str}`}
        >
          <div class="p-[6px] rounded-full bg-transparent group-hover:bg-twitter-blue/10 transition-colors">
            <Reply class="size-4 fill-twitter-blue stroke-twitter-blue" />
          </div>
          <span
            class="font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-blue transition-colors group-hover:text-twitter-blue"
          >Reply</span
          >
        </Link>

        <button
          class="flex items-center group gap-0.5 copy__tweet cursor-pointer disabled:cursor-default"
          data-tweet={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
        >
          <div
            class="p-[6px] rounded-full bg-transparent group-hover:bg-twitter-green/10 !group-disabled:bg-transparent transition-colors"
          >
            <Chain
              class="size-4 stroke-content group-hover:stroke-twitter-green transition-colors chain !group-disabled:stroke-content"
            />
            <Checkmark class="size-4 hidden check" />
          </div>

          <span
            class="font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-green transition-colors group-hover:text-twitter-green !group-disabled:text-content !group-disabled:underline-transparent"
          >Copy Link</span
          >
        </button>
      </div>
    </div>

    <Link
      href={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
      class="grid place-items-center hover:bg-twitter-blue/10 transition-colors text-twitter-blue border border-separator text-sm font-semibold rounded-full py-1"
    >
      Read {numberFormatter.format(tweet.conversation_count)} replies
    </Link>

    <Link
      href={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
      class="top-4 right-4 absolute stroke-content transition-colors hover:stroke-heading"
    >
      <Icon class="size-5" />
    </Link>
  </div>}



{!hasCustomRenderer && <style>
.astro-xitter-container {
    --xitter-blue: oklch(0.682 0.158 243.354);
    --xitter-red: oklch(0.63 0.258 4.67);
    --xitter-gold: oklch(0.739 0.161 85.8);
    --xitter-gray: oklch(0.669 0.035 231.2);
    --xitter-green: oklch(0.686 0.178 161.4);

    --xitter-background: white;
    --xitter-separator: oklch(0.8791 0.0129 228.95);
    --xitter-content: oklch(21% 0.034 264.665);
    --xitter-heading: black;

    --xitter-spacing: 0.25rem;

    --xitter-font-sm: 14px;
    --xitter-font-md: 16px;
    --xitter-font-lg: 18px;

    --xitter-transition-timing: 150ms;
    --xitter-transition-easing: cubic-bezier(0.33, 1, 0.68, 1); /* easeOutCubic */

    position: relative;
    display: flex;
    flex-direction: column;
    margin: auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 550px;
    padding: 2 * var(--xitter-spacing);
    font-size: var(--xitter-font-md);

    border-radius: 3 * var(--xitter-spacing);
    border: 1px solid var(--xitter-separator);
    background-color: var(--xitter-background);
}

@media (prefers-color-scheme: dark) {
    .astro-xitter-container {
        --xitter-background: oklch(13% 0.028 261.692);
        --xitter-heading: white;
        --xitter-content: oklch(96.7% 0.003 264.542);
    }
}

@media (prefers-reduced-motion: reduce) {
    .astro-xitter-container {
        --xitter-transition-timing: 0ms;
    }
}

.astro-xitter-header-container {
    display: flex;
    align-items: center;
    gap: 2 * var(--xitter-spacing);
    margin-bottom: 3 * var(--xitter-spacing);
}

.astro-xitter-profile-picture {
    flex-shrink: 0;
}

.astro-xitter-profile-avatar {
    filter: brightness(1);
    transition: filter var(--xitter-transition-timing) var(--xitter-transition-easing);
    border-radius: 9999px;

    &:hover, &:focus {
        filter: brightness(0.9);
    }

    &.astro-xitter-profile-avatar-square {
        border-radius: 4 * var(--xitter-spacing);
    }
}

.astro-xitter-profile {
    display:flex;
    flex-direction: column;
    align-items: center;
    gap: var(--xitter-spacing);
}

.astro-xitter-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2 * var(--xitter-spacing);
    transition: text-decoration-color var(--xitter-transition-timing) var(--xitter-transition-easing);
}

,astro-xitter-profile-name {
    font-weight: 600;
    color: var(--xitter-heading);
    display: inline-flex;
    align-items: center;
    gap: var(--xitter-spacing);

    &:hover, &:focus-visible {
        text-decoration-color: var(--xitter-heading);
    }
}

.astro-xitter-profile-verified-badge {
    & > .astro-xitter-profile-verified-checkmark {
        fill: var(--xitter-heading);
    }

    &.astro-xitter-profile-verified-business > .astro-xitter-profile-verified-bubble {
        fill: var(--xitter-gold);
    }

    &.astro-xitter-profile-verified-government > .astro-xitter-profile-verified-bubble {
        fill: var(--xitter-gray);
    }

    &.astro-xitter-profile-verified-personal > .astro-xitter-profile-verified-bubble {
        fill: var(--xitter-blue);
    }
}

.astro-xitter-profile-screen {
    display: flex;
    align-items: center;
    line-height: 1;
    gap: var(--xitter-spacing);
    font-size: var(--xitter-font-sm);
}

.astro-xitter-profile-screen-name {
    color: var(--xitter-content);
    font-size: var(--xitter-font-sm);
}

.astro-xitter-profile-screen-follow {
    font-weight: 600;
    color: var(--xitter-blue);
    font-size: var(--xitter-font-sm);

    &:hover, &:focus-visible {
        text-decoration-color: var(--xitter-blue);
    }
}

.astro-xitter-content {
    white-space: pre-wrap;

    "leading-snug whitespace-pre-wrap md:text-lg dark:text-heading mb-3"
}
</style>}

{!hasCustomRenderer && <script>
  const buttons = document.querySelectorAll('.copy__tweet');
  const playButtons = document.querySelectorAll('.play__button');

  for (const b of buttons) {
    const button = b as HTMLButtonElement;

    button.addEventListener('click', async () => {
      const tweet = button.dataset.tweet;
      const chain = button.querySelector('.chain');
      const check = button.querySelector('.check');
      const text = button.querySelector('span');

      if (!navigator.clipboard || !tweet || !chain || !check || !text) {
        return;
      }

      await navigator.clipboard.writeText(tweet);

      text.textContent = 'Copied!';
      chain.classList.toggle('hidden');
      check.classList.toggle('hidden');
      button.disabled = true;

      setTimeout(() => {
        text.textContent = 'Copy Link';
        chain.classList.toggle('hidden');
        check.classList.toggle('hidden');
        button.disabled = false;
      }, 2_500);
    });

    for (const pb of playButtons) {
      pb.addEventListener('click', () => {
        const playButton = pb as HTMLButtonElement;
        const par = pb.parentElement;
        if (!par) {
          return;
        }

        const vid = par.querySelector('video');
        const watchOn = par.querySelector('a');
        if (!vid) {
          return;
        }

        vid.setAttribute('controls', 'true');
        vid.play();

        playButton.style.opacity = '0';
        playButton.style.pointerEvents = 'none';

        if (watchOn) {
          watchOn.style.opacity = '0';
          watchOn.style.pointerEvents = 'none';

          vid.addEventListener('pause', () => {
            if (!vid.ended) {
              watchOn.textContent = 'Continue watching on X';
              watchOn.style.opacity = '1';
              watchOn.style.pointerEvents = 'auto';
            }
          });

          vid.addEventListener('play', () => {
            watchOn.style.opacity = '0';
            watchOn.style.pointerEvents = 'none';
          });
        }
      });
    }
  }
</script>}
