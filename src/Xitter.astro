---
import type { Xitter } from '@/types';

import Chain from '@/icons/Chain.astro';
import Checkmark from '@/icons/Checkmark.astro';
import Heart from '@/icons/Heart.astro';
import Info from '@/icons/Info.astro';
import Play from '@/icons/Play.astro';
import Reply from '@/icons/Reply.astro';
import X from '@/icons/X.astro';
import Link from '@/Link.astro';
import XitterContent from '@/XitterContent.astro';
import XitterHeader from '@/XitterHeader.astro';
import XitterPhotos from '@/XitterPhotos.astro';

import Quote from './Quote.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;

const url = new URL('/tweet-result', 'https://cdn.syndication.twimg.com/');
url.searchParams.set('id', id);
url.searchParams.set('token', 'x');

const result = await fetch(url);
const tweet = (await result.json()) as Xitter;

const numberFormatter = new Intl.NumberFormat('en-US', {
  style: 'decimal',
  notation: 'compact',
  compactDisplay: 'short',
  minimumFractionDigits: 0,
  maximumFractionDigits: 1,
});

const entityRegex = /https:\/\/t.co\/.+$/v;
tweet.text = tweet.text.replace(entityRegex, '').trim();

const hasCustomRenderer = Astro.slots.has('default');

const renderedContent = hasCustomRenderer
  ? await Astro.slots.render('default', [tweet])
  : null;
---

{renderedContent
  ? <Fragment set:html={renderedContent} />
  : <div class="astro-xitter-container">
    <XitterHeader tweet={tweet} />

    <XitterContent tweet={tweet} />

    {
      tweet.photos && tweet.photos.length > 0 && <XitterPhotos tweet={tweet} />
    }

    {
      tweet.video && (

      )
    }

    {
      tweet.quoted_tweet && (
        <Quote
          tweet={tweet.quoted_tweet}
        />
      )
    }

    <div class="flex items-center justify-between text-sm text-content/70 mb-[6px]">
      <Link
        href={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
        class="underline underline-offset-2 underline-transparent hover:underline-content/70 transition-colors leading-none"
      >
        {
          new Date(tweet.created_at).toLocaleString('en-US', {
            hour: '2-digit',
            minute: '2-digit',
          })
        }
      &#8239;&middot;&#8239;
        {
          new Date(tweet.created_at).toLocaleString('en-US', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          })
        }
      </Link>

      <Link
        href="https://help.x.com/en/x-for-websites-ads-info-and-privacy"
        class="group hover:bg-twitter-blue/10 p-[6px] rounded-full transition-colors"
      >
        <Info class="size-4 text-content/70 group-hover:text-twitter-blue transition-colors" />
      </Link>
    </div>

    <div class="h-px w-full border border-separator/50 mb-[6px]"></div>

    <div class="mb-[6px]">
      <div class="flex items-center gap-2">
        <Link
          title="Like this Tweet"
          class="flex items-center group gap-0.5"
          href={`https://x.com/intent/like?tweet_id=${tweet.id_str}`}
        >
          <div class="p-[6px] rounded-full bg-transparent group-hover:bg-twitter-red/10 transition-colors">
            <Heart class="size-4 text-twitter-red" />
          </div>
          <span
            class="font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-red transition-colors group-hover:text-twitter-red"
          >{numberFormatter.format(tweet.favorite_count)}</span
          >
        </Link>

        <Link
          title="Reply this Tweet"
          class="flex items-center group gap-0.5"
          href={`https://x.com/intent/tweet?in_reply_to=${tweet.id_str}`}
        >
          <div class="p-[6px] rounded-full bg-transparent group-hover:bg-twitter-blue/10 transition-colors">
            <Reply class="size-4 fill-twitter-blue stroke-twitter-blue" />
          </div>
          <span
            class="font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-blue transition-colors group-hover:text-twitter-blue"
          >Reply</span
          >
        </Link>

        <button
          class="flex items-center group gap-0.5 copy__tweet cursor-pointer disabled:cursor-default"
          data-tweet={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
        >
          <div
            class="p-[6px] rounded-full bg-transparent group-hover:bg-twitter-green/10 !group-disabled:bg-transparent transition-colors"
          >
            <Chain
              class="size-4 stroke-content group-hover:stroke-twitter-green transition-colors chain !group-disabled:stroke-content"
            />
            <Checkmark class="size-4 hidden check" />
          </div>

          <span
            class="font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-green transition-colors group-hover:text-twitter-green !group-disabled:text-content !group-disabled:underline-transparent"
          >Copy Link</span
          >
        </button>
      </div>
    </div>

    <Link
      href={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
      class="grid place-items-center hover:bg-twitter-blue/10 transition-colors text-twitter-blue border border-separator text-sm font-semibold rounded-full py-1"
    >
      Read {numberFormatter.format(tweet.conversation_count)} replies
    </Link>

    <Link
      href={`${host}/${tweet.user.screen_name}/status/${tweet.id_str}`}
      class="top-4 right-4 absolute stroke-content transition-colors hover:stroke-heading"
    >
      <Icon class="size-5" />
    </Link>
  </div>}

{!hasCustomRenderer && <style>
.astro-xitter-container {
    --xitter-blue: oklch(0.682 0.158 243.354);
    --xitter-red: oklch(0.63 0.258 4.67);
    --xitter-gold: oklch(0.739 0.161 85.8);
    --xitter-gray: oklch(0.669 0.035 231.2);
    --xitter-green: oklch(0.686 0.178 161.4);

    --xitter-background: white;
    --xitter-separator: oklch(0.8791 0.0129 228.95);
    --xitter-content: oklch(21% 0.034 264.665);
    --xitter-heading: black;
    --xitter-subheading: oklch(0.4939 0.0294 241.16);

    --xitter-spacing: 0.25rem;

    --xitter-font-sm: 14px;
    --xitter-font-md: 16px;
    --xitter-font-lg: 18px;

    --xitter-transition-timing: 150ms;
    --xitter-transition-easing: cubic-bezier(0.33, 1, 0.68, 1); /* easeOutCubic */

    position: relative;
    display: flex;
    flex-direction: column;
    margin: auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 550px;
    padding: 2 * var(--xitter-spacing);
    font-size: var(--xitter-font-md);

    border-radius: 3 * var(--xitter-spacing);
    border: 1px solid var(--xitter-separator);
    background-color: var(--xitter-background);
}

@media (prefers-color-scheme: dark) {
    .astro-xitter-container {
        --xitter-background: oklch(13% 0.028 261.692);
        --xitter-heading: white;
        --xitter-content: oklch(96.7% 0.003 264.542);
    }
}

@media (prefers-reduced-motion: reduce) {
    .astro-xitter-container {
        --xitter-transition-timing: 0ms;
    }
}

.astro-xitter-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2 * var(--xitter-spacing);
    transition: text-decoration-color var(--xitter-transition-timing) var(--xitter-transition-easing);
}
</style>}

{!hasCustomRenderer && <script>
  const buttons = document.querySelectorAll('.copy__tweet');
  const playButtons = document.querySelectorAll('.play__button');

  for (const b of buttons) {
    const button = b as HTMLButtonElement;

    button.addEventListener('click', async () => {
      const tweet = button.dataset.tweet;
      const chain = button.querySelector('.chain');
      const check = button.querySelector('.check');
      const text = button.querySelector('span');

      if (!navigator.clipboard || !tweet || !chain || !check || !text) {
        return;
      }

      await navigator.clipboard.writeText(tweet);

      text.textContent = 'Copied!';
      chain.classList.toggle('hidden');
      check.classList.toggle('hidden');
      button.disabled = true;

      setTimeout(() => {
        text.textContent = 'Copy Link';
        chain.classList.toggle('hidden');
        check.classList.toggle('hidden');
        button.disabled = false;
      }, 2_500);
    });

    for (const pb of playButtons) {
      pb.addEventListener('click', () => {
        const playButton = pb as HTMLButtonElement;
        const par = pb.parentElement;
        if (!par) {
          return;
        }

        const vid = par.querySelector('video');
        const watchOn = par.querySelector('a');
        if (!vid) {
          return;
        }

        vid.setAttribute('controls', 'true');
        vid.play();

        playButton.style.opacity = '0';
        playButton.style.pointerEvents = 'none';

        if (watchOn) {
          watchOn.style.opacity = '0';
          watchOn.style.pointerEvents = 'none';

          vid.addEventListener('pause', () => {
            if (!vid.ended) {
              watchOn.textContent = 'Continue watching on X';
              watchOn.style.opacity = '1';
              watchOn.style.pointerEvents = 'auto';
            }
          });

          vid.addEventListener('play', () => {
            watchOn.style.opacity = '0';
            watchOn.style.pointerEvents = 'none';
          });
        }
      });
    }
  }
</script>}
