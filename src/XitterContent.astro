---
import type { Xitter } from './types';

import Link from '@/Link.astro';

interface Props {
  tweet: Xitter;
}

const { tweet } = Astro.props;

const isTruncated = !!tweet.note_tweet;
---

<p class="astro-xitter-content">
  {tweet.text}
  {
    isTruncated && (
      <>
        <>... </>
        <Link
          class="astro-xitter-content-truncated-notice astro-xitter-link"
          href={`https://x.com/${tweet.user.screen_name}/status/${tweet.id_str}`}
        >
          Show More
        </Link>
      </>
    )
  }
</p>

<style>
.astro-xitter-content {
    white-space: pre-wrap;
    line-height: 1.375;
    color: var(--xitter-content);
    margin-top: 3 * var(--xitter-spacing);
}

@media (min-width: 768px) {
    .astro-xitter-content {
        font-size: var(--xitter-font-lg);
    }
}

.astro-xitter-content-truncated-notice {
    color: var(--xitter-blue);

    &:hover, &:focus-visible {
        text-decoration-color: var(--xitter-blue);
    }
}
</style>
