{
  "format_on_save": "on",
  "formatter": "language_server",
  "code_actions_on_format": {
    "source.fixAll.eslint": true,
    "source.organizeImports": true
  },
  "language_servers": ["!biome", "!oxfmt", "!oxlint", "!typescript-ls"],
  "languages": {
    "JavaScript": {
      "language_servers": ["eslint"]
    },
    "TypeScript": {
      "language_servers": ["vtsls", "eslint"]
    },
    "Astro": {
      "language_servers": ["astro-language-server", "vtsls", "eslint"]
    },
    "JSON": {
      "language_servers": ["json-language-server", "vtsls", "eslint"]
    }
  }
}
